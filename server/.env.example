# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Security & Authentication Secrets
# In production, generate with: openssl rand -base64 32
JWT_SECRET=super_secret_jwt_key_signal_whatsapp_private_instance_98234789
JWT_EXPIRES_IN=7d

# Two-User Enforced Isolation
MAX_USERS_ALLOWED=2

# Optional Invite Code required for User 2 (leave blank to let User 1 generate in-app)
INVITE_CODE=

# Upload Settings
MAX_FILE_SIZE_MB=10

# ---------------------------------------------------------------------
# DATABASE CONFIGURATION (PostgreSQL / Supabase / Neon / Render)
# ---------------------------------------------------------------------
# To connect to PostgreSQL or Supabase, provide DATABASE_URL below:
# Format: postgresql://username:password@hostname:5432/dbname
# Example Supabase: postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# Example Local: postgresql://postgres:postgres@localhost:5432/private_chat
DATABASE_URL=

# Or individual PostgreSQL parameters (used if DATABASE_URL is not set):
# DB_TYPE=postgres
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=private_chat
# PGSSL=false

# Note: If DATABASE_URL is empty, the app seamlessly defaults to the
# zero-config built-in SQLite WAL database at server/data/private_chat.db.
